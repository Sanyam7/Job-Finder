# ─────────────────────────────────────────────────────────────────────────────
# VeriHire API — environment
# Copy to `.env` and fill in. The process refuses to boot if a required value is
# missing or malformed (see src/config/env.js).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Comma-separated. Must include every origin the SPA is served from.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=false

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/verihire
MONGO_MAX_POOL=10

# ── JWT ──────────────────────────────────────────────────────────────────────
# Both must be >= 32 characters AND different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-DIFFERENT-long-random-string-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7
JWT_ISSUER=verihire

# ── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECRET=change-me-to-a-random-string
COOKIE_DOMAIN=
REFRESH_COOKIE_NAME=vh_rt

# ── Passwords ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Cloudinary (resumes + logos) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=verihire
SIGNED_URL_TTL_SECONDS=300

# ── Email ────────────────────────────────────────────────────────────────────
# Set EMAIL_ENABLED=false to render messages into the log instead of sending them.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VeriHire <no-reply@verihire.app>
EMAIL_ENABLED=false

# ── Redis (queues, rate limiting, cache) ─────────────────────────────────────
# Optional in development. Without it, resume parsing runs inline and rate limits
# are per-process. Required in production.
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=verihire

# ── Optional LLM resume enrichment ───────────────────────────────────────────
# The deterministic parser works fully on its own; this only improves accuracy on
# unusual resume layouts.
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=20000

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ANON=100
RATE_LIMIT_MAX_AUTH=300
RATE_LIMIT_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_TO_FILE=false
MONGO_DEBUG=false

# ── First admin (consumed by `npm run seed:admin`) ───────────────────────────
ADMIN_SEED_EMAIL=admin@verihire.app
ADMIN_SEED_PASSWORD=ChangeMe!2026
ADMIN_SEED_NAME=Platform Admin

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_SWAGGER=true
ENABLE_CRON=true
