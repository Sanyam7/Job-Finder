# Response headers for the VeriHire client.
#
# In client/public/ for the same reason as _redirects: the rules ship inside dist/ and so
# survive a direct folder deploy, which netlify.toml headers do not.

/*
  # The app is never legitimately framed, and a job portal — where people type real
  # credentials and upload real CVs — is a credible clickjacking target. DENY rather than
  # SAMEORIGIN because there is no same-origin framing either.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here uses these. Denying them now means a future dependency cannot quietly
  # start using them without someone noticing this line.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  #
  # NOTE — no Content-Security-Policy yet, deliberately.
  #
  # client/index.html runs an inline <script> to resolve the theme before React mounts, so
  # dark-mode users do not get a white flash. Any CSP without either a sha256 hash of that
  # block or 'unsafe-inline' would kill it. Netlify serves static files, so a per-response
  # nonce is not available, and a hardcoded hash breaks silently the moment anyone edits
  # those few lines. A CSP is worth adding — it needs the theme script moved into the
  # bundle, or the hash generated by the build, not a header guessed here.

# Vite fingerprints everything under /assets, so those URLs are immutable by construction.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must never be cached, or a returning visitor keeps a stale document that
# points at asset hashes which no longer exist.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
